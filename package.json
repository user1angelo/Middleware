{
  "name": "middleware-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run bootstrap",
    "bootstrap": "npm install --prefix webapp/backend && npm install --prefix webapp/frontend",
    "start": "concurrently \"npm start --prefix webapp/backend\" \"npm start --prefix webapp/frontend\"",
    "start:backend": "npm start --prefix webapp/backend",
    "start:frontend": "npm start --prefix webapp/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}