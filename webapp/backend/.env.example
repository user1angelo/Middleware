PORT=3001

# PostgreSQL Configuration
DB_HOST=192.168.1.8
DB_PORT=5432
DB_NAME=NIS1
DB_USER=postgres
DB_PASSWORD=user

# RabbitMQ Configuration
RABBITMQ_HOST=192.168.1.8
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# RabbitMQ Management API (for safe, non-disruptive stats)
RABBITMQ_MGMT_HOST=192.168.1.8
RABBITMQ_MGMT_PORT=15672
RABBITMQ_MGMT_USER=user
RABBITMQ_MGMT_PASSWORD=password
RABBITMQ_MGMT_PROTOCOL=http
ENABLE_RABBITMQ_STATS=true
RABBITMQ_STATS_INTERVAL_MS=3000

# Optional: enable dashboard RabbitMQ log tap (consumes messages!)
ENABLE_RABBITMQ_LOG_TAP=false

# Middleware Paths
MIDDLEWARE_ROOT=/home/keyanluwi/Documents/GitHub/Middleware
THREAT_CONTEXT_STORE_PATH=/home/keyanluwi/Documents/GitHub/Middleware/ThreatContextStore
MODULE_REGISTRY_PATH=/home/keyanluwi/Documents/GitHub/Middleware/ModuleRegistryLifecycleManager
WORKFLOW_ENGINE_PATH=/home/keyanluwi/Documents/GitHub/Middleware/WorkflowEngine
TCS_TESTER_PATH=/home/keyanluwi/Documents/GitHub/Middleware/ThreatContextStoreTester

# Log Files Directory
LOGS_DIR=/home/keyanluwi/Documents/GitHub/Middleware/webapp/logs
