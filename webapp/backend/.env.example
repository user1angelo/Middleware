PORT=3001

# PostgreSQL Configuration
# For a portable setup, default to localhost and a sample database.
# Change these to match your environment if needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=middleware
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Management API (for safe, non-disruptive stats)
RABBITMQ_MGMT_HOST=localhost
RABBITMQ_MGMT_PORT=15672
RABBITMQ_MGMT_USER=guest
RABBITMQ_MGMT_PASSWORD=guest
RABBITMQ_MGMT_PROTOCOL=http
ENABLE_RABBITMQ_STATS=true
RABBITMQ_STATS_INTERVAL_MS=3000

# Optional: enable dashboard RabbitMQ log tap (consumes messages!)
ENABLE_RABBITMQ_LOG_TAP=false

# Middleware Paths
# These are relative to the backend directory (webapp/backend).
# If you keep the repo layout, these defaults should work out-of-the-box.
MIDDLEWARE_ROOT=../..
THREAT_CONTEXT_STORE_PATH=../../ThreatContextStore
MODULE_REGISTRY_PATH=../../ModuleRegistryLifecycleManager
WORKFLOW_ENGINE_PATH=../../WorkflowEngine
TCS_TESTER_PATH=../../ThreatContextStoreTester

# Log Files Directory (relative to this backend folder)
LOGS_DIR=../logs
