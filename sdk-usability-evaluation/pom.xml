<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nis1.thesis</groupId>
        <artifactId>nis1-thesis</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sdk-usability-evaluation</artifactId>
    <packaging>jar</packaging>
    <name>SDK Usability Evaluation Kit</name>
    <description>
        Fill-in-the-blank skeletons (FooGuardStandaloneSkeleton, FooGuardMitigationSkeleton) for
        evaluators to complete using nis-thesis-sdk, so they can rate the SDK against Clarke's
        (2005) Cognitive Dimensions from firsthand experience rather than from reading about it.
        Not part of the runtime system - never loaded by ModuleRegistry/SdkModuleHost.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- NIS Thesis SDK - the API surface being evaluated -->
        <dependency>
            <groupId>com.nis1.thesis</groupId>
            <artifactId>nis-thesis-sdk</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- RabbitMQ client (FooGuardStandaloneSkeleton talks to the bus directly, like SuricataModule) -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
        </dependency>

        <!-- JSON Processing -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>

        <!-- Gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
